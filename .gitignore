# Allowlist: the public repo holds only what the app needs to run, set up, and pass CI.
# Everything else (agent org files, backlog, internal docs, editor config, ts-watch tooling,
# customer material) stays local. To publish a new top-level file, add a `!/name` line here.
/*
!/.gitignore
!/.github/
!/.env.example
!/README.md
!/LICENSE
!/index.html
!/config.js
!/server.js
!/package.json
!/package-lock.json
!/ts-sdk-version.json
!/css/
!/js/
!/lib/
!/scripts/
!/docs/

# docs/: only the public guide (vantage-sales-analytics.vercel.app/docs/tse-best-practices.html)
# and the integration write-ups the README and app UI link to.
/docs/*
!/docs/tse-best-practices.html
!/docs/callback-action.md
!/docs/customize-export.md
!/docs/spotter-mcp-chat.md
!/docs/webhook-inbox-demo.md

# ts-watch / guide-refresh tooling (agent org, not the app)
/scripts/check-ts-updates.mjs
/scripts/check-ts-updates.test.mjs
/scripts/guide-check.mjs

# Anywhere
.DS_Store
*.swp
node_modules/
.env
