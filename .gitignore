# macOS
.DS_Store
.AppleDouble
.LSOverride
*.swp

# Local settings & config (but track the org's shared skills/commands; agents stay local)
.claude/*
!.claude/skills/
!.claude/commands/

# Agent instructions — kept locally, out of the public repo
CLAUDE.md
.vscode/mcp.json
node_modules/
.env

# Self-hosted SDK copy (generated by `npm run vendor-sdk`)
vendor/

# Unused / archived material — kept locally, out of the repo
misc/

# Plan-mode dumps (superseded by docs/ts-watch-playbook.md)
Plan/

# Personal editor workspaces
*.code-workspace

# Docs — new docs stay local (they can hold customer material). Already-tracked docs stay
# tracked; add a new public doc on purpose with `git add -f`.
docs/
