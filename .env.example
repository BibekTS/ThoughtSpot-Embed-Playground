# ───────────────────────────────────────────────────────────────────────────────────────────────
# ThoughtSpot Embed Playground — server configuration
#
# You DO NOT need this file for the basic flow. `npm start` works with browser-session auth and no
# config at all. Only set this up if you want Trusted Auth (minting tokens).
#
#   npm run setup     copies this file to .env (won't overwrite an existing one)
#   then fill in the two REQUIRED values below and run `npm start`.
#
# .env is gitignored — NEVER commit it.
# ───────────────────────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for Trusted Auth ────────────────────────────────────────────────────────────────────

# Full URL of your ThoughtSpot instance.
THOUGHTSPOT_HOST=https://your-instance.thoughtspot.cloud

# Trusted-auth secret key. ThoughtSpot → Develop → Customizations → Security Settings →
# Trusted authentication. Stays server-side only and is NEVER sent to the browser.
TS_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────

# The user the server mints for when the UI leaves the username blank. SET THIS TO YOUR ThoughtSpot
# username (the placeholder 'tsadmin' only works if that user actually exists on your instance).
TS_DEFAULT_USERNAME=tsadmin

# Extra usernames the server may ALSO mint for (comma-separated). Leave BLANK to allow just the
# default user above — that's all most people need. Fail-closed: only listed users are permitted,
# and if BOTH this and TS_DEFAULT_USERNAME are blank the server refuses EVERY mint (403).
TS_USERNAME_ALLOWLIST=

# Default Org id (blank = the org tied to the secret key / primary org).
TS_DEFAULT_ORG_ID=

# Port for the server + static frontend.
PORT=3000

# ── Advanced dev guards (all fail-closed; relax only for a local playground) ──────────────────────

# Allow JIT provisioning (auto_create). When false, the server REFUSES auto_create so the browser
# can't provision a brand-new user. Note this governs CREATION only: TS_USERNAME_ALLOWLIST still
# applies with auto_create on, so enabling JIT never widens WHICH usernames may be minted for.
TS_ALLOW_JIT=false

# Groups the browser may request via group_identifiers. Comma-separated; fail-closed (empty = none).
# Use '*' to allow ANY group — needed to test arbitrary group-keyed RLS in the claims playground.
#   e.g.  TS_GROUP_ALLOWLIST=Sales,Marketing      or      TS_GROUP_ALLOWLIST=*
TS_GROUP_ALLOWLIST=

# Enable the /api/writeback stub sink (the write-back custom action demo).
TS_ALLOW_DEV_PROXY=false

# Express `trust proxy`. Leave BLANK (off) unless a real reverse proxy sits in front: with it on,
# req.ip becomes the caller-supplied leftmost X-Forwarded-For, so rotating that header walks past
# the rate limiter. Accepts false/true, 'loopback', a hop count, or a list of trusted proxy IPs.
TS_TRUST_PROXY=

# The one non-loopback Host header this server will answer to (blank = loopback only). Every route
# except the /api/webhook receiver refuses a foreign Host, so a tunnel or a DNS-rebinding page can't
# reach the mint endpoint. Set this ONLY if you deliberately front the server with a hostname.
TS_PUBLIC_HOST=

# ── Webhook receiver demo (docs/webhook-inbox-demo.md) ───────────────────────────────────────────

# Enable the /api/webhook receiver. Fail-closed: off means it is never an open data sink.
# TS_ALLOW_WEBHOOK_SINK=false

# Shared secret for HMAC_SHA256 signature verification. When SET, attachments from deliveries that
# fail verification are NOT retained (the metadata row still shows the rejected attempt).
# TS_WEBHOOK_SECRET=

# Memory bound for the in-memory inbox: total retained attachment bytes across all events (default
# 100 MB, evicted oldest-first) and the files retained per delivery (default 10).
# TS_WEBHOOK_MAX_BYTES=104857600
# TS_WEBHOOK_MAX_FILES=10

# The inbox read/clear endpoints (/api/webhook/events, /api/webhook/file/*) are loopback-only.
# Set true ONLY if you really want them reachable through TS_PUBLIC_HOST.
# TS_WEBHOOK_PUBLIC=false

# ── Spotter Chat (MCP) — optional overrides ──────────────────────────────────────────────────────
# Nothing is required here. The relay forwards YOUR OWN bearer (from trusted auth, or from the
# token behind your browser session) and never mints, so it works as soon as you connect in the UI.

# MCP endpoint. The default (api-version=beta) is the ONLY version exposing the session tools
# create_analysis_session / send_session_message / get_session_updates; api-version=2025-01-01
# connects but serves the older toolset. Leave blank for the default.
#   TS_MCP_URL=https://agent.thoughtspot.app/token/mcp?api-version=beta
TS_MCP_URL=

# Pin every analysis session to one Worksheet/Model GUID. Blank = the UI's data-source picker
# decides (and "Auto" lets Spotter choose per question).
TS_MCP_DATA_SOURCE_ID=
